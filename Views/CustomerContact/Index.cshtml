@using SimpleCRM.Helpers
@model IEnumerable<SimpleCRM.Models.CustomerContact.CustomerContactResponse>

@{
    ViewData["Title"] = "Customer Contacts";
    var FileVersion = DateTime.Now.Ticks;
}

<input id="HiddenModel" type="hidden" value="@CommonHelpers.SerializeObject(Model)" />

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6 col-12">
            <h2>Customer Contacts</h2>
        </div>
        <div class="col-md-6 col-12 text-md-end text-start mt-2 mt-md-0">
            <button type="button" class="btn btn-primary" id="btnAddCustomerContact">
                <i class="bi bi-plus-circle"></i> Add Contact
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="customerContactTable">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Customer</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customerContactTableBody">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Customer Contact Modal (Add/Edit) -->
<div class="modal fade" id="customerContactModal" tabindex="-1" aria-labelledby="customerContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerContactModalLabel">Add Customer Contact</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="customerContactForm">
                    <input type="hidden" id="contactId" value="0" />

                    <div class="row">
                        <div class="col-md-6 col-12 mb-3">
                            <label for="customerId" class="form-label">Customer <span class="text-danger">*</span></label>
                            <select class="form-select" id="customerId">
                                <option value="">Select Customer</option>
                                <!-- Populated by JavaScript -->
                            </select>
                            <div class="error-message text-danger small"></div>
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label for="mobileNo" class="form-label">Mobile Number</label>
                            <input type="text" class="form-control" id="mobileNo" maxlength="100" />
                            <div class="error-message text-danger small"></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-12 mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" maxlength="100" />
                            <div class="error-message text-danger small"></div>
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label for="phoneNumber" class="form-label">Phone Number</label>
                            <input type="text" class="form-control" id="phoneNumber" maxlength="100" />
                            <div class="error-message text-danger small"></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label for="address" class="form-label">Address</label>
                            <textarea class="form-control" id="address" rows="2" maxlength="100"></textarea>
                            <div class="error-message text-danger small"></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-12 mb-3">
                            <label for="city" class="form-label">City</label>
                            <input type="text" class="form-control" id="city" maxlength="100" />
                            <div class="error-message text-danger small"></div>
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label for="state" class="form-label">State</label>
                            <select class="form-select" id="state">
                                <option value="">Select State</option>
                                <!-- Populated by JavaScript -->
                            </select>
                            <div class="error-message text-danger small"></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveCustomerContact">Save Contact</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this contact?</p>
                <p><strong id="deleteContactInfo"></strong></p>
                <input type="hidden" id="deleteContactId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script defer src="/js/customerContact.js?v=@FileVersion" type="text/javascript"></script>
}
