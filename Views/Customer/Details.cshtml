@model SimpleCRM.Models.Customer.CustomerResponse

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h2>Customer Details</h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 col-md-10 col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Model.CompanyName</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Id</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Company Name</dt>
                        <dd class="col-sm-9">@Model.CompanyName</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                        <dt class="col-sm-3">Phone</dt>
                        <dd class="col-sm-9">@(Model.Phone ?? "N/A")</dd>

                        <dt class="col-sm-3">City</dt>
                        <dd class="col-sm-9">@(Model.City ?? "N/A")</dd>

                        <dt class="col-sm-3">Address</dt>
                        <dd class="col-sm-9">@(Model.Address ?? "N/A")</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-@(Model.IsActive ? "success" : "secondary")">
                                @Model.Status
                            </span>
                        </dd>

                        <dt class="col-sm-3">Created At</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
