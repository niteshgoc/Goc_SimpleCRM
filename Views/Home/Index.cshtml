@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">Welcome to SimpleCRM</h2>
                    <p class="text-muted">Manage your customer relationships efficiently</p>
                </div>
                <div class="text-muted">
                    <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("MMMM dd, yyyy")
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Customers</p>
                            <h3 class="mb-0 fw-bold">0</h3>
                            <small class="text-success"><i class="bi bi-arrow-up"></i> Active</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Active Leads</p>
                            <h3 class="mb-0 fw-bold">0</h3>
                            <small class="text-info"><i class="bi bi-graph-up"></i> Pending</small>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-funnel-fill text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Deals Closed</p>
                            <h3 class="mb-0 fw-bold">0</h3>
                            <small class="text-success"><i class="bi bi-check-circle"></i> This Month</small>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-trophy-fill text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Revenue</p>
                            <h3 class="mb-0 fw-bold">$0</h3>
                            <small class="text-warning"><i class="bi bi-currency-dollar"></i> Total</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-graph-up-arrow text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Access Section -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3">Quick Access</h4>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Customer Management Card -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100 hover-card">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-people-fill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title mb-2">Customer Management</h5>
                    <p class="card-text text-muted mb-3">View, add, edit and manage all your customers</p>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-primary w-100">
                        <i class="bi bi-arrow-right-circle"></i> Manage Customers
                    </a>
                </div>
            </div>
        </div>

        <!-- Leads Management Card -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100 hover-card">
                <div class="card-body text-center p-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-funnel-fill text-info" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title mb-2">Leads & Opportunities</h5>
                    <p class="card-text text-muted mb-3">Track and convert leads into customers</p>
                    <button class="btn btn-info w-100" disabled>
                        <i class="bi bi-hourglass-split"></i> Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Reports Card -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100 hover-card">
                <div class="card-body text-center p-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-bar-chart-fill text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title mb-2">Reports & Analytics</h5>
                    <p class="card-text text-muted mb-3">View detailed reports and analytics</p>
                    <button class="btn btn-success w-100" disabled>
                        <i class="bi bi-hourglass-split"></i> Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Sales Pipeline Card -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100 hover-card">
                <div class="card-body text-center p-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-diagram-3-fill text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title mb-2">Sales Pipeline</h5>
                    <p class="card-text text-muted mb-3">Monitor your sales pipeline and deals</p>
                    <button class="btn btn-warning w-100" disabled>
                        <i class="bi bi-hourglass-split"></i> Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Tasks Card -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100 hover-card">
                <div class="card-body text-center p-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-list-check text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title mb-2">Tasks & Activities</h5>
                    <p class="card-text text-muted mb-3">Manage your tasks and activities</p>
                    <button class="btn btn-danger w-100" disabled>
                        <i class="bi bi-hourglass-split"></i> Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Settings Card -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
            <div class="card border-0 shadow-sm h-100 hover-card">
                <div class="card-body text-center p-4">
                    <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-gear-fill text-secondary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title mb-2">Settings</h5>
                    <p class="card-text text-muted mb-3">Configure your CRM system settings</p>
                    <button class="btn btn-secondary w-100" disabled>
                        <i class="bi bi-hourglass-split"></i> Coming Soon
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Section -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0"><i class="bi bi-activity"></i> Recent Activity</h5>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">No recent activity to display</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .card {
        border-radius: 12px;
    }

    .rounded-circle {
        width: fit-content;
    }
</style>
